# Copy to .env and fill in locally:  cp .env.example .env
# .env is gitignored. Load it into a shell with:  set -a; source .env; set +a
# Placeholders only. Never put a real value in THIS file; it is committed.

# Notion integration token for scripts/adapters/notion.py (source_of_truth: notion).
# Leave empty when your canon is markdown. In GitHub Actions this comes from the
# NOTION_TOKEN repository secret, never from a file.
NOTION_TOKEN=

# Which contract the sync reads. The nightly workflow reads the same value from the
# CONTEXT_CONTRACT repository variable and falls back to this default.
CONTEXT_CONTRACT=templates/contracts/context-contract.yaml

# Optional incoming-webhook URL. check_freshness.py --webhook-env ALERT_WEBHOOK_URL
# POSTs {status, last_synced_at, age_days, threshold_days} here when the mirror is stale.
ALERT_WEBHOOK_URL=
